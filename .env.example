APP_NAME=Mini Bank API
# Use "development" apenas localmente. Sem esta variável a aplicação assume produção
# e se recusa a iniciar com uma SECRET_KEY fraca ou de exemplo.
ENVIRONMENT=development
# Gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Separe por vírgula (ou use uma lista JSON)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
MAX_TRANSACTION_CENTS=100000000
RATE_LIMIT_LOGIN=5/minute

# PostgreSQL do Docker Compose. O Compose monta o DATABASE_URL da API a partir destes
# valores, então basta alterá-los aqui. Use apenas letras e números na senha.
POSTGRES_USER=bank_user
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=mini_bank

# Opcional: só para rodar a API fora do Docker apontando para o Postgres do Compose.
# DATABASE_URL=postgresql+psycopg2://bank_user:change_me_local_only@localhost:5432/mini_bank
